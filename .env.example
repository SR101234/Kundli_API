# ==============================================================
# Kundli Calculation Engine - Hostinger VPS Environment Config
# ==============================================================

# MongoDB Connection
# For local MongoDB container (e.g. docker-compose): mongodb://mongo:27017
# For local systemd MongoDB: mongodb://127.0.0.1:27017
# For MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=kundli_db

# Admin Security Key for Admin Dashboard access
ADMIN_KEY=admin@kundli2026
DEFAULT_CHECK_LIMIT=10

# Server Binding
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=production
WORKERS=2

# CORS Allowed Origins (* allows all, or https://yourdomain.com)
CORS_ORIGINS=*
